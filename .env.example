# Local infrastructure started by compose.yml
POSTGRES_USER=akb
POSTGRES_PASSWORD=akb_local_password
POSTGRES_DB=ai_knowledge_base
POSTGRES_PORT=5432
DATABASE_URL=postgresql://akb:akb_local_password@localhost:5432/ai_knowledge_base?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Applications
API_PORT=3000
VITE_API_BASE_URL=http://localhost:3000
WORKER_CONCURRENCY=2
UPLOAD_DIR=../../data/uploads

# M2 demo administrator and short-lived access session
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_use
ADMIN_NAME=Demo Admin
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN_SECONDS=3600
