generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

generator workerClient {
  provider     = "prisma-client"
  output       = "../apps/worker/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique @db.VarChar(255)
  passwordHash   String          @map("password_hash") @db.VarChar(255)
  name           String          @db.VarChar(120)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  knowledgeBases KnowledgeBase[]
  operationLogs  OperationLog[]

  @@map("users")
}

model KnowledgeBase {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String     @db.VarChar(120)
  description         String?    @db.Text
  status              String     @default("ACTIVE") @db.VarChar(20)
  chunkSize           Int        @default(800) @map("chunk_size")
  chunkOverlap        Int        @default(120) @map("chunk_overlap")
  topK                Int        @default(5) @map("top_k")
  similarityThreshold Float      @default(0.65) @map("similarity_threshold")
  chatModel           String     @default("openai/gpt-4o-mini") @map("chat_model") @db.VarChar(160)
  embeddingModel      String     @default("openai/text-embedding-3-small") @map("embedding_model") @db.VarChar(160)
  createdById         String     @map("created_by_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  createdBy           User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  documents           Document[]

  @@index([createdById])
  @@map("knowledge_bases")
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  knowledgeBaseId String         @map("knowledge_base_id") @db.Uuid
  originalName    String         @map("original_name") @db.VarChar(255)
  storagePath     String         @map("storage_path") @db.VarChar(500)
  mimeType        String         @map("mime_type") @db.VarChar(120)
  size            Int
  status          String         @default("PENDING") @db.VarChar(30)
  errorMessage    String?        @map("error_message") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  knowledgeBase   KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  ingestionJobs   IngestionJob[]

  @@index([knowledgeBaseId])
  @@index([status])
  @@map("documents")
}

model IngestionJob {
  id           String    @id @default(uuid()) @db.Uuid
  documentId   String    @map("document_id") @db.Uuid
  queueJobId   String    @unique @map("queue_job_id") @db.VarChar(120)
  status       String    @default("WAITING") @db.VarChar(30)
  progress     Int       @default(0)
  attempt      Int       @default(0)
  maxAttempts  Int       @default(3) @map("max_attempts")
  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([status])
  @@map("ingestion_jobs")
}

model OperationLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(80)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(80)
  detail       Json?
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("operation_logs")
}
